// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. BETTER AUTH TABLES (User Management)
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Better Auth admin plugin fields
  role          String    @default("construction_manager")
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  managedProjects Project[]
  preferences     UserPreference?
  dayComments     EmployeeDayComment[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   // Used for email/password credentials login
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ==========================================
// 2. GRIDSPATCH TABLES (Core Logic)
// ==========================================

model Employee {
  id          String         @id @default(cuid())
  name        String
  initials    String
  img         String?        // Profile image URL
  role        String?        // e.g., "Foreman", "Apprentice"
  startDate   DateTime?      @db.Date
  endDate     DateTime?      @db.Date
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  assignments    Assignment[]
  availabilities Availability[]
  dayComments    EmployeeDayComment[]
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("planned") // planned | active | on_hold | done | inactive
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  constructionManagerId String?
  constructionManager   User?   @relation(fields: [constructionManagerId], references: [id], onDelete: SetNull)

  assignments        Assignment[]
  statusTransitions  ProjectStatusTransition[]
}

model ProjectStatusTransition {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  weekStartDate DateTime @db.Date
  status        String   // planned | active | on_hold | done | inactive
  createdAt     DateTime @default(now())

  @@unique([projectId, weekStartDate])
  @@index([projectId])
}

model Week {
  id          String         @id @default(cuid())
  startDate   DateTime       @unique @db.Date
  endDate     DateTime       @db.Date
  isCurrent   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  assignments    Assignment[]
  availabilities Availability[]
}

enum DayPart {
  full_day
  pre_lunch
  after_lunch
}

model Assignment {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  dayPart    DayPart  @default(full_day)
  weekId     String
  week       Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date, dayPart])
  @@index([weekId, date])
  @@index([projectId, date])
}

model Availability {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  weekId     String
  week       Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  dayPart    DayPart  @default(full_day)
  status     String   // "sick" | "vacation"
  createdAt  DateTime @default(now())

  @@unique([employeeId, date, dayPart])
  @@index([weekId])
}

model EmployeeDayComment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text       String
  createdAt  DateTime @default(now())

  @@index([employeeId, date])
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  type      String   // "public_holiday" | "company_holiday"
  createdAt DateTime @default(now())
}

// Single row (id always "singleton") holding company-wide settings.
model CompanySettings {
  id          String   @id
  hoursPerDay Int      @default(8)
  updatedAt   DateTime @updatedAt
}

model UserPreference {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accentColor String? // hex, e.g. "#4f7cf0"
  amColor     String? // AM hue, e.g. "#dcbe7d"
  pmColor     String? // PM hue, e.g. "#82aafa"
  uiScale     Float?  // e.g. 1.0
  theme       String? // "light" | "dark" | null (system default = dark)
  locale      String? // e.g. "en" | "de"
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  action    String   // create | update | delete | upsert | createMany | updateMany | deleteMany
  model     String   // Assignment | Employee | Project | …
  path      String?  // HTTP referer (which page triggered the change)
  payload   Json?    // prisma args at call time

  @@index([createdAt(sort: Desc)])
  @@index([model])
}
